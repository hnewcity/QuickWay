{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickWay",
  "version": "0.3.1",
  "identifier": "dev.quickway.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickWay",
        "width": 1120,
        "height": 790,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#141510"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "publisher": "QuickWay",
    "shortDescription": "Quick 模型聊天与 Claude Code 桌面连接器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
