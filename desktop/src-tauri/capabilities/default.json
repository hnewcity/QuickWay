{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "QuickWay main window with local folder selection and its own title bar controls",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
